@startuml build-and-deploy
' Build and deploy pipeline, from Java source to a live page.
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam shadowing false
skinparam ArrowColor #4A6FA5
skinparam activity {
    BackgroundColor #F7F9FC
    BorderColor #4A6FA5
    FontSize 13
    DiamondBackgroundColor #FFF8DC
    DiamondBorderColor #C9A227
}
skinparam partition {
    BackgroundColor #F2F5F9
    BorderColor #8FA8C8
    FontSize 14
}
skinparam note {
    BackgroundColor #FFF8DC
    BorderColor #C9A227
    FontSize 12
}

title Fra Java-kildekode til live-side

partition "Trin 1 - skriv Java" #EAF6EA {
    :Ret klasser under src/main/java;
}

partition "Trin 2 - byg (én kommando)" #FDF0E6 {
    :`mvn package`;
    note right
      Kompilerer kildekoden to gange
      fra samme kode:
      - target/*.jar  (almindelig JVM)
      - target/teavm/ (WebAssembly)
    end note
    :TeaVM skriver til target/teavm/;
    :Maven kopierer selv de to
    nødvendige filer til docs/teavm/;
    note right
      Automatisk, sat op i pom.xml
      (copy-web-build-to-docs).
      Kun:
      - classes.wasm
      - classes.wasm-runtime.js
      Ingen manuel kopiering.
    end note
}

partition "Trin 3 - tjek lokalt" #EAF6EA {
    :python3 -m http.server 8011 -d docs;
    :Åbn http://localhost:8011/;
    if (virker siden?) then (ja)
    else (nej)
        :ret koden, kør `mvn package` igen;
        stop
    endif
}

partition "Trin 4 - commit og udgiv" #DCE6F2 {
    :commit docs/teavm og push til GitHub;
    :GitHub Pages serverer docs/ som siden;
    note right
      Slås kun til én gang:
      Settings -> Pages
      -> Deploy from a branch
      -> master, mappe /docs
      Intet bygges på GitHubs side.
    end note
    :Siden er live på
    https://mwnDK1402.github.io/filmsamling/;
}

@enduml
